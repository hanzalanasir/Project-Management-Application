{
  "name": "project-management-app.web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:api": "openapi-typescript ../../docs/contracts/auth.v1.yaml -o src/app/core/api/generated/auth.v1.d.ts",
    "generate:api:projects": "openapi-typescript ../../docs/contracts/projects.v1.yaml -o src/app/core/api/generated/projects.v1.d.ts",
    "generate:api:tasks": "openapi-typescript ../../docs/contracts/tasks.v1.yaml -o src/app/core/api/generated/tasks.v1.d.ts",
    "generate:api:team": "openapi-typescript ../../docs/contracts/team.v1.yaml -o src/app/core/api/generated/team.v1.d.ts",
    "generate:api:dashboard": "openapi-typescript ../../docs/contracts/dashboard.v1.yaml -o src/app/core/api/generated/dashboard.v1.d.ts",
    "generate:api:reports": "openapi-typescript ../../docs/contracts/reports.v1.yaml -o src/app/core/api/generated/reports.v1.d.ts"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ngrx/effects": "^22.0.0-beta.1",
    "@ngrx/store": "^22.0.0-beta.1",
    "@ngrx/store-devtools": "^22.0.0-beta.1",
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "papaparse": "^5.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
