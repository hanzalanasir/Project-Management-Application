<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0bfa7365-e439-442a-a851-5f6b3bc77731</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjectManagementApp.Application\ProjectManagementApp.Application.csproj" />
    <ProjectReference Include="..\ProjectManagementApp.Infrastructure\ProjectManagementApp.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Contract drift gate (ADR-0007 §1, research.md R-5). CI always sets
       -p:CheckApiContract=true; local builds do not by default — opt in with
       `dotnet build -p:CheckApiContract=true` (see quickstart.md). -->
  <Target Name="CheckApiContract" AfterTargets="Build" Condition="'$(CheckApiContract)' == 'true'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)../../artifacts/openapi" />
    <Exec Command="dotnet tool run swagger tofile --output &quot;$(MSBuildThisFileDirectory)../../artifacts/openapi/generated.json&quot; &quot;$(TargetPath)&quot; v1" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
    <!-- The prefix-base flag below matters: the contract declares a servers entry with url /api,
         so its paths are written relative to that (e.g. /auth/register), while the Swashbuckle
         generated spec has no servers entry and bakes /api into the literal path (controllers
         route under api/[controller]). Without this flag oasdiff compares the literal path
         strings and reports every endpoint as breaking/removed regardless of any real change. -->
    <Exec Command="oasdiff breaking &quot;$(MSBuildThisFileDirectory)../../docs/contracts/auth.v1.yaml&quot; &quot;$(MSBuildThisFileDirectory)../../artifacts/openapi/generated.json&quot; --prefix-base /api --fail-on ERR" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
  </Target>

</Project>
