{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ProjectManagementApp",
    "Audience": "ProjectManagementApp",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 15
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RefreshCookie": {
    "Name": "refresh_token",
    "SameSite": "Strict",
    "Secure": true,
    "Path": "/api/auth"
  },
  "Csrf": {
    "HeaderName": "X-XSRF-TOKEN"
  },
  "Seed": {
    "Enabled": false,
    "DemoDataEnabled": false
  },
  "Users": {
    "Paging": {
      "DefaultPageSize": 20,
      "MaxPageSize": 100
    }
  },
  "Projects": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "DefaultStatus": "Planning",
    "MaskOutOfScopeAs404": false,
    "AllowOwnershipTransfer": true,
    "MaxNameLength": 200,
    "MaxDescriptionLength": 2000
  },
  "Tasks": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "DefaultStatus": "ToDo",
    "DefaultPriority": "Medium",
    "EnforceStatusWorkflow": false,
    "AllowUnassigned": true,
    "AllowAssignToInactiveUser": false,
    "AllowWritesToTerminalStatusProject": true,
    "MaskOutOfScopeAs404": false,
    "MaxTitleLength": 200,
    "MaxDescriptionLength": 2000
  }
}
