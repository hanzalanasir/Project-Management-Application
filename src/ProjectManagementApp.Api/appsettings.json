{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ProjectManagementApp",
    "Audience": "ProjectManagementApp",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 15
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RefreshCookie": {
    "Name": "refresh_token",
    "SameSite": "Strict",
    "Secure": true,
    "Path": "/api/auth"
  },
  "Csrf": {
    "HeaderName": "X-XSRF-TOKEN"
  },
  "Seed": {
    "Enabled": false
  },
  "Users": {
    "Paging": {
      "DefaultPageSize": 20,
      "MaxPageSize": 100
    }
  }
}
